# Relative paths are resolved from api/. Keep the local SQLite file ignored.
RAYRIDE_DATABASE_PATH=data/rayride.sqlite3
# Use an absolute path if tesseract is not on PATH. Forward slashes work on Windows.
RAYRIDE_TESSERACT_EXECUTABLE=tesseract
# Total Tesseract time budget per ticket, in seconds.
RAYRIDE_OCR_TIMEOUT_SECONDS=8
