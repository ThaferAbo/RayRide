  "info": {
    "description": "Local flight-ticket extraction and simulated reservations.",
    "title": "RayRide CSE491 API",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/reservations": {
      "post": {
        "operationId": "create_reservation_api_v1_reservations_post",
        "parameters": [
          {
            "description": "Optional version 4 UUID. Reuse it for identical retries.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReservationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationResponse"
                }
              }
            },
            "description": "Saved reservation returned for an identical retry"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationErrorResponse"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationErrorResponse"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Create Reservation",
        "tags": [
          "reservations"
        ]
      }
    },
    "/api/v1/reservations/{reference}": {
      "get": {
        "operationId": "get_reservation_api_v1_reservations__reference__get",
        "parameters": [
          {
            "in": "path",
            "name": "reference",
            "required": true,
            "schema": {
              "pattern": "^RR-[A-Z0-9]{12}$",
              "title": "Reference",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Get Reservation",
        "tags": [
          "reservations"
        ]
      }
    },
    "/api/v1/tickets/extract": {
      "post": {
        "description": "Returns editable suggestions. OCR failures and unreadable fields can be entered manually.",
        "operationId": "extract_ticket_api_v1_tickets_extract_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "encoding": {
                "ticket": {
                  "contentType": "application/pdf, image/png, image/jpeg"
                }
              },
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "ticket": {
                    "format": "binary",
                    "type": "string"
                  }
                },
                "required": [
                  "ticket"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractionResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketErrorResponse"
                }
              }
            },
            "description": "Missing or malformed multipart file"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketErrorResponse"
                }
              }
            },
            "description": "Upload or document exceeds a supported limit"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketErrorResponse"
                }
              }
            },
            "description": "Unsupported or mismatched file type"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketErrorResponse"
                }
              }
            },
            "description": "Corrupt, empty, or unsupported document"
          }
        },
        "summary": "Extract flight suggestions from a PDF, PNG, or JPEG ticket"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Health"
      }
    }
  }
}
